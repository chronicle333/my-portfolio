---
/**
 * Footer.astro
 *
 * Site-wide footer — imported once in Layout.astro and shared across every page.
 * Edit the links, social URLs, and brand name below to match your own info.
 */
---

<footer class="bg-slate-900 text-slate-400 mt-auto">
    <!-- Main footer grid -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10">
            <!-- Column 1: Brand and tagline -->
            <div>
                <a href="/" class="text-xl font-bold text-white tracking-tight">
                    Dev<span class="text-blue-400">Portfolio</span>
                </a>
                <p class="mt-3 text-sm leading-relaxed">
                    Building clean, fast websites for local businesses and
                    beyond. Based online — available worldwide.
                </p>
                <!-- Social icons — update the href values to your real profiles -->
                <div class="flex gap-4 mt-5">
                    <!-- GitHub -->
                    <a
                        href="#"
                        aria-label="GitHub"
                        class="hover:text-white transition-colors"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482
                       0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463
                       -.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831
                       .092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683
                       -.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836a9.59 9.59 0
                       012.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028
                       1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012
                       2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"
                            ></path>
                        </svg>
                    </a>

                    <!-- LinkedIn -->
                    <a
                        href="#"
                        aria-label="LinkedIn"
                        class="hover:text-white transition-colors"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M19 3a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h14zm-5 6.5a2.5
                       2.5 0 00-2.5 2.5V17h2v-4.5a.5.5 0 011 0V17h2v-5a2.5 2.5 0 00-2.5-2.5zM8 9H6v8h2V9zm-1-3a1
                       1 0 110 2 1 1 0 010-2z"
                            ></path>
                        </svg>
                    </a>

                    <!-- Twitter / X -->
                    <a
                        href="#"
                        aria-label="Twitter"
                        class="hover:text-white transition-colors"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68
                       l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Column 2: Quick Links -->
            <div>
                <h3
                    class="text-white font-semibold text-sm uppercase tracking-wider mb-4"
                >
                    Quick Links
                </h3>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a href="/" class="hover:text-white transition-colors"
                            >Home</a
                        >
                    </li>
                    <li>
                        <a
                            href="/#about"
                            class="hover:text-white transition-colors">About</a
                        >
                    </li>
                    <li>
                        <a
                            href="/#projects"
                            class="hover:text-white transition-colors"
                            >Projects</a
                        >
                    </li>
                    <li>
                        <a
                            href="/#contact"
                            class="hover:text-white transition-colors"
                            >Contact</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Column 3: Services -->
            <div>
                <h3
                    class="text-white font-semibold text-sm uppercase tracking-wider mb-4"
                >
                    Services
                </h3>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a
                            href="/services/solar"
                            class="hover:text-white transition-colors"
                            >☀️ Solar Website</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/barbershop"
                            class="hover:text-white transition-colors"
                            >✂️ Barbershop Website</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/electrician"
                            class="hover:text-white transition-colors"
                            >⚡ Electrician Website</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/photography"
                            class="hover:text-white transition-colors"
                            >📷 Photography Website</a
                        >
                    </li>
                </ul>
            </div>
        </div><!-- /grid -->
    </div><!-- /max-w container -->

    <!-- Bottom bar: copyright -->
    <div class="border-t border-slate-800">
        <div
            class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-500"
        >
            <p>
                &copy; {new Date().getFullYear()} DevPortfolio. All rights reserved.
            </p>
            <p>
                Built with <a
                    href="https://astro.build"
                    class="hover:text-white transition-colors">Astro</a
                > &amp; <a
                    href="https://tailwindcss.com"
                    class="hover:text-white transition-colors">Tailwind CSS</a
                >
            </p>
        </div>
    </div>
</footer>
