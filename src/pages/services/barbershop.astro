---
/**
 * barbershop.astro — Barbershop Website Service Page
 *
 * Route: /services/barbershop
 *
 * SECTIONS:
 *   1. Hero        — Page title, subtitle, and breadcrumb
 *   2. Overview    — Description + placeholder image
 *   3. Features    — Grid of what's included
 *   4. CTA         — Call to action to get in touch
 */

import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Barbershop Website Design | DevPortfolio"
    description="Professional website design for barbershops and hair salons. Online booking, service menus, galleries, and more — built to bring in new clients."
>
    <!-- ============================================================
       SECTION 1: HERO
       Dark, bold styling to match the barbershop premium feel
       ============================================================ -->
    <section
        class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-purple-900 text-white overflow-hidden"
    >
        <!-- Decorative background blobs -->
        <div class="absolute inset-0 opacity-10 pointer-events-none">
            <div
                class="absolute top-10 right-20 w-80 h-80 bg-purple-400 rounded-full blur-3xl"
            >
            </div>
            <div
                class="absolute bottom-0 left-10 w-64 h-64 bg-violet-500 rounded-full blur-3xl"
            >
            </div>
        </div>

        <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-20 md:py-28">
            <!-- Breadcrumb navigation -->
            <nav class="flex items-center gap-2 text-sm text-slate-400 mb-8">
                <a href="/" class="hover:text-white transition-colors">Home</a>
                <span>/</span>
                <a href="/#projects" class="hover:text-white transition-colors"
                    >Services</a
                >
                <span>/</span>
                <span class="text-purple-400">Barbershop Website</span>
            </nav>

            <!-- Hero content -->
            <div class="max-w-3xl">
                <!-- Industry badge -->
                <span
                    class="inline-flex items-center gap-2 bg-purple-400/10 text-purple-400 border border-purple-400/20 text-sm font-medium px-3 py-1 rounded-full mb-6"
                >
                    ✂️ Barbershop & Salon Industry
                </span>

                <h1
                    class="text-4xl sm:text-5xl md:text-6xl font-bold leading-tight"
                >
                    Barbershop Websites That
                    <span class="text-purple-400"> Fill Your Chair</span>
                </h1>

                <p
                    class="mt-6 text-lg text-slate-300 leading-relaxed max-w-2xl"
                >
                    I build sharp, stylish websites for barbershops and salons
                    that make booking easy, showcase your cuts, and turn
                    first-time visitors into loyal regulars.
                </p>

                <div class="mt-8 flex flex-wrap gap-4">
                    <a
                        href="/#contact"
                        class="bg-purple-600 hover:bg-purple-500 text-white font-semibold px-6 py-3 rounded-lg transition-colors shadow-lg shadow-purple-600/25"
                    >
                        Get a Free Quote
                    </a>
                    <a
                        href="#overview"
                        class="bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-3 rounded-lg border border-white/20 transition-colors"
                    >
                        Learn More
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
       SECTION 2: OVERVIEW
       Description of the service + placeholder image side by side
       ============================================================ -->
    <section id="overview" class="py-20 md:py-28 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <!-- Left: description text -->
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <span class="w-8 h-0.5 bg-purple-600"></span>
                        <span
                            class="text-purple-600 font-medium text-sm uppercase tracking-wider"
                            >What I Build</span
                        >
                    </div>

                    <h2 class="text-3xl sm:text-4xl font-bold text-slate-900">
                        A Website as Sharp as Your Cuts
                    </h2>

                    <div class="mt-6 space-y-4 text-slate-600 leading-relaxed">
                        <p>
                            Most barbershop websites are outdated, hard to
                            navigate on mobile, and missing the most important
                            feature — a simple way to book an appointment.
                            That's what I fix.
                        </p>
                        <p>
                            I design modern, mobile-first barbershop websites
                            that show off your style, list your services and
                            prices clearly, and make it dead simple for new
                            clients to find you and book a seat.
                        </p>
                        <p>
                            Whether you're a one-chair solo barber or a full
                            shop with multiple staff, your website will match
                            your brand and work for your business 24/7 — even
                            while you're behind the chair.
                        </p>
                    </div>

                    <!-- Quick stats -->
                    <div
                        class="mt-8 grid grid-cols-3 gap-6 pt-8 border-t border-slate-100"
                    >
                        <div>
                            <p class="text-2xl font-bold text-purple-600">
                                Bold
                            </p>
                            <p class="text-sm text-slate-500 mt-0.5">
                                Visual Design
                            </p>
                        </div>
                        <div>
                            <p class="text-2xl font-bold text-purple-600">
                                Easy
                            </p>
                            <p class="text-sm text-slate-500 mt-0.5">
                                Online Booking
                            </p>
                        </div>
                        <div>
                            <p class="text-2xl font-bold text-purple-600">
                                Fast
                            </p>
                            <p class="text-sm text-slate-500 mt-0.5">
                                Load Speed
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Right: image -->
                <div class="relative">
                    <img
                        src="https://picsum.photos/seed/barbershop-interior-chairs/600/480"
                        alt="Preview of a barbershop website design"
                        class="rounded-2xl shadow-xl w-full object-cover border border-slate-100"
                        width="600"
                        height="480"
                    />
                    <!-- Floating label on image -->
                    <div
                        class="absolute -top-4 -right-4 bg-purple-600 text-white text-sm font-bold px-4 py-2 rounded-xl shadow-lg"
                    >
                        ✂️ Barbershop Niche
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
       SECTION 3: FEATURES
       Grid of what's included in a barbershop website package
       ============================================================ -->
    <section class="py-20 md:py-28 bg-slate-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <!-- Section header -->
            <div class="text-center mb-14">
                <div class="flex items-center justify-center gap-3 mb-4">
                    <span class="w-8 h-0.5 bg-purple-600"></span>
                    <span
                        class="text-purple-600 font-medium text-sm uppercase tracking-wider"
                        >What's Included</span
                    >
                    <span class="w-8 h-0.5 bg-purple-600"></span>
                </div>
                <h2 class="text-3xl sm:text-4xl font-bold text-slate-900">
                    Every Barbershop Website Includes
                </h2>
                <p class="mt-4 text-slate-600 max-w-xl mx-auto">
                    Everything your shop needs to look professional online and
                    keep clients coming back — built in from day one.
                </p>
            </div>

            <!-- Features grid — 6 cards in 3 columns -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Feature 1 -->
                <div
                    class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
                >
                    <div
                        class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center text-2xl mb-4"
                    >
                        📅
                    </div>
                    <h3 class="font-bold text-slate-900 text-lg">
                        Online Booking Section
                    </h3>
                    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                        A clearly visible booking button or embedded scheduling
                        widget so clients can request an appointment any time of
                        day — no phone tag required.
                    </p>
                </div>

                <!-- Feature 2 -->
                <div
                    class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
                >
                    <div
                        class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center text-2xl mb-4"
                    >
                        💈
                    </div>
                    <h3 class="font-bold text-slate-900 text-lg">
                        Services & Pricing Menu
                    </h3>
                    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                        A clean, easy-to-read menu listing every service you
                        offer with prices. No more "what's it cost?" calls —
                        clients arrive informed and ready.
                    </p>
                </div>

                <!-- Feature 3 -->
                <div
                    class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
                >
                    <div
                        class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center text-2xl mb-4"
                    >
                        🖼️
                    </div>
                    <h3 class="font-bold text-slate-900 text-lg">
                        Photo Gallery
                    </h3>
                    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                        Show off your best work with a sharp photo gallery of
                        haircuts and fades. Your skills speak louder than any
                        description — let the photos do the talking.
                    </p>
                </div>

                <!-- Feature 4 -->
                <div
                    class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
                >
                    <div
                        class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center text-2xl mb-4"
                    >
                        🗣️
                    </div>
                    <h3 class="font-bold text-slate-900 text-lg">
                        Client Testimonials
                    </h3>
                    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                        Highlight your best Google or Facebook reviews directly
                        on your site. Word-of-mouth is your strongest marketing
                        tool — your website should reflect that.
                    </p>
                </div>

                <!-- Feature 5 -->
                <div
                    class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
                >
                    <div
                        class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center text-2xl mb-4"
                    >
                        📍
                    </div>
                    <h3 class="font-bold text-slate-900 text-lg">
                        Location & Hours
                    </h3>
                    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                        Embedded Google Maps, your full address, phone number,
                        and opening hours — all clearly visible so clients can
                        find you without frustration.
                    </p>
                </div>

                <!-- Feature 6 -->
                <div
                    class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
                >
                    <div
                        class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center text-2xl mb-4"
                    >
                        📱
                    </div>
                    <h3 class="font-bold text-slate-900 text-lg">
                        Mobile-First Design
                    </h3>
                    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                        Your clients are browsing on their phones. Every
                        barbershop site I build is designed mobile-first — fast,
                        touch-friendly, and pixel-perfect on any screen.
                    </p>
                </div>
            </div>

            <!-- Full-width preview image -->
            <div class="mt-16">
                <img
                    src="https://picsum.photos/seed/barbershop-scissors-wide/1200/400"
                    alt="Full width preview of a barbershop website layout"
                    class="rounded-2xl shadow-lg w-full object-cover border border-purple-100"
                    width="1200"
                    height="400"
                />
            </div>
        </div>
    </section>

    <!-- ============================================================
       SECTION 4: CTA
       Final push to get the visitor to reach out
       ============================================================ -->
    <section
        class="py-20 md:py-24 bg-gradient-to-br from-purple-700 to-violet-800"
    >
        <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
            <span
                class="inline-block text-4xl mb-4 drop-shadow-sm"
                aria-hidden="true">✂️</span
            >
            <h2 class="text-3xl sm:text-4xl font-bold text-white leading-tight">
                Ready to Level Up Your Barbershop Online?
            </h2>
            <p
                class="mt-4 text-purple-200 text-lg max-w-xl mx-auto leading-relaxed"
            >
                Let's build a site that looks as good as the cuts you give. Get
                in touch for a free, no-obligation quote — I'll respond within
                24 hours.
            </p>

            <!-- CTA buttons -->
            <div class="mt-8 flex flex-wrap justify-center gap-4">
                <a
                    href="/#contact"
                    class="bg-white text-purple-700 hover:bg-purple-50 font-bold px-8 py-3 rounded-lg transition-colors shadow-lg"
                >
                    Start My Project
                </a>
                <a
                    href="/#projects"
                    class="bg-purple-600/40 hover:bg-purple-600/60 text-white font-semibold px-8 py-3 rounded-lg border border-white/30 transition-colors"
                >
                    See More Examples
                </a>
            </div>

            <!-- Reassurance line -->
            <p class="mt-6 text-purple-300 text-sm">
                Free consultation · No pressure · Response within 24 hours
            </p>
        </div>
    </section>
</Layout>
