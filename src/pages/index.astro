---
import Layout from "../layouts/Layout.astro";
import HeroSVG from "../components/HeroSVG.astro";
import AboutSVG from "../components/AboutSVG.astro";
---

<Layout
    title="DevPortfolio — Frontend Developer"
    description="Frontend developer specializing in clean, fast websites built with Astro and Tailwind CSS."
>
    <!-- ============================================================
       SECTION 1: HERO
       ============================================================ -->
    <section
        class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-blue-900 text-white overflow-hidden"
    >
        <div class="absolute inset-0 opacity-10">
            <div
                class="absolute top-20 left-10 w-72 h-72 bg-blue-500 rounded-full blur-3xl"
            >
            </div>
            <div
                class="absolute bottom-10 right-10 w-96 h-96 bg-indigo-500 rounded-full blur-3xl"
            >
            </div>
        </div>

        <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-24 md:py-32">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <!-- Left column: text content -->
                <div>
                    <p
                        class="inline-flex items-center gap-2 text-blue-400 font-medium text-sm mb-4 bg-blue-400/10 px-3 py-1 rounded-full border border-blue-400/20"
                    >
                        <span
                            class="w-2 h-2 bg-blue-400 rounded-full animate-pulse"
                        ></span>
                        Available for new projects
                    </p>

                    <h1
                        class="text-4xl sm:text-5xl md:text-6xl font-bold leading-tight tracking-tight"
                    >
                        Building Websites
                        <span class="text-blue-400"> That Work</span>
                        <br />For Real Businesses
                    </h1>

                    <p
                        class="mt-6 text-lg text-slate-300 leading-relaxed max-w-lg"
                    >
                        I'm a frontend developer with a strong foundation in
                        HTML &amp; CSS, now building fast, modern sites with
                        Astro and Tailwind CSS. Clean code. Real results.
                    </p>

                    <div class="mt-8 flex flex-wrap gap-4">
                        <a
                            href="/#projects"
                            class="bg-blue-600 hover:bg-blue-500 text-white font-semibold px-6 py-3 rounded-lg transition-colors shadow-lg shadow-blue-600/25"
                        >
                            View My Work
                        </a>
                        <a
                            href="/#contact"
                            class="bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-3 rounded-lg border border-white/20 transition-colors backdrop-blur-sm"
                        >
                            Get In Touch
                        </a>
                    </div>

                    <div class="mt-12 flex flex-wrap gap-8">
                        <div>
                            <p class="text-2xl font-bold text-white">10+</p>
                            <p class="text-sm text-slate-400 mt-0.5">
                                Projects Built
                            </p>
                        </div>
                        <div class="w-px bg-slate-700"></div>
                        <div>
                            <p class="text-2xl font-bold text-white">4+</p>
                            <p class="text-sm text-slate-400 mt-0.5">
                                Industries Served
                            </p>
                        </div>
                        <div class="w-px bg-slate-700"></div>
                        <div>
                            <p class="text-2xl font-bold text-white">100%</p>
                            <p class="text-sm text-slate-400 mt-0.5">
                                Client Satisfaction
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Right column: browser mockup SVG -->
                <div class="flex justify-center md:justify-end">
                    <div class="relative">
                        <HeroSVG />
                        <!-- Floating badge -->
                        <div
                            class="absolute -bottom-4 -left-4 bg-white text-slate-900 rounded-xl shadow-xl px-4 py-3 flex items-center gap-3"
                        >
                            <div
                                class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center text-white text-lg"
                            >
                                ✓
                            </div>
                            <div>
                                <p class="text-xs text-slate-500">
                                    Latest Project
                                </p>
                                <p class="text-sm font-semibold">
                                    Solar Co. Website
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
       SECTION 2: ABOUT
       id="about" — linked from navbar
       ============================================================ -->
    <section id="about" class="py-20 md:py-28 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <div class="flex items-center gap-3 mb-4">
                <span class="w-8 h-0.5 bg-blue-600"></span>
                <span
                    class="text-blue-600 font-medium text-sm uppercase tracking-wider"
                    >About Me</span
                >
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <!-- Left: code editor SVG illustration -->
                <div class="order-2 md:order-1">
                    <AboutSVG />
                </div>

                <!-- Right: bio and skills -->
                <div class="order-1 md:order-2">
                    <h2
                        class="text-3xl sm:text-4xl font-bold text-slate-900 leading-tight"
                    >
                        From Static HTML to<br />
                        <span class="text-blue-600">Modern Web Dev</span>
                    </h2>

                    <div class="mt-6 space-y-4 text-slate-600 leading-relaxed">
                        <p>
                            I started my web journey the way most developers do
                            — writing raw HTML and CSS, pixel by pixel. I know
                            what it means to build a layout from scratch without
                            frameworks or shortcuts.
                        </p>
                        <p>
                            Now I'm expanding my stack with <strong
                                class="text-slate-800">Astro</strong
                            >
                            and <strong class="text-slate-800"
                                >Tailwind CSS</strong
                            > to build sites that are faster, cleaner, and easier
                            to maintain — while still keeping full control over the
                            HTML and styles I write.
                        </p>
                        <p>
                            I specialize in creating websites for local
                            businesses that need a professional online presence
                            without the bloat of heavy frameworks.
                        </p>
                    </div>

                    <!-- Skills grid -->
                    <div class="mt-8">
                        <h3
                            class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-4"
                        >
                            Skills &amp; Tools
                        </h3>
                        <div class="flex flex-wrap gap-2">
                            {
                                [
                                    { name: "HTML5", emoji: "🏗️" },
                                    { name: "CSS3", emoji: "🎨" },
                                    { name: "Tailwind CSS", emoji: "💨" },
                                    { name: "Astro", emoji: "🚀" },
                                    { name: "JavaScript", emoji: "⚡" },
                                    { name: "Responsive", emoji: "📱" },
                                    { name: "SEO", emoji: "🔍" },
                                    { name: "Git", emoji: "🌿" },
                                ].map((skill) => (
                                    <span class="inline-flex items-center gap-1.5 bg-slate-100 hover:bg-blue-50 hover:text-blue-700 text-slate-700 text-sm font-medium px-3 py-1.5 rounded-lg transition-colors cursor-default border border-transparent hover:border-blue-200">
                                        <span>{skill.emoji}</span>
                                        {skill.name}
                                    </span>
                                ))
                            }
                        </div>
                    </div>

                    <!-- Download CV link -->
                    <div class="mt-8">
                        <a
                            href="#"
                            class="inline-flex items-center gap-2 text-blue-600 font-semibold hover:text-blue-700 transition-colors group"
                        >
                            Download CV
                            <svg
                                class="w-4 h-4 transition-transform group-hover:translate-y-0.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                                ></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
       SECTION 3: PROJECTS
       id="projects" — linked from navbar
       ============================================================ -->
    <section id="projects" class="py-20 md:py-28 bg-slate-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-14">
                <div class="flex items-center justify-center gap-3 mb-4">
                    <span class="w-8 h-0.5 bg-blue-600"></span>
                    <span
                        class="text-blue-600 font-medium text-sm uppercase tracking-wider"
                        >My Work</span
                    >
                    <span class="w-8 h-0.5 bg-blue-600"></span>
                </div>
                <h2 class="text-3xl sm:text-4xl font-bold text-slate-900">
                    Recent Projects
                </h2>
                <p class="mt-4 text-slate-600 max-w-xl mx-auto">
                    A selection of websites I've designed and built for real
                    clients and personal practice projects.
                </p>
            </div>

            <!-- Project cards grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- ── Project Card 1: Solar ── -->
                <article
                    class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col"
                >
                    <div class="overflow-hidden">
                        <img
                            src="https://images.unsplash.com/photo-1509391366360-2e959784a276?w=600&h=360&fit=crop&auto=format"
                            alt="Solar panels installed on a residential rooftop"
                            class="w-full h-48 object-cover hover:scale-105 transition-transform duration-500"
                            width="600"
                            height="360"
                        />
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <div class="flex gap-2 mb-3">
                            <span
                                class="text-xs font-medium bg-blue-50 text-blue-600 px-2 py-0.5 rounded-md"
                                >Astro</span
                            >
                            <span
                                class="text-xs font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded-md"
                                >Tailwind</span
                            >
                        </div>
                        <h3 class="text-lg font-bold text-slate-900">
                            Solar Co. Website
                        </h3>
                        <p
                            class="mt-2 text-sm text-slate-600 leading-relaxed flex-1"
                        >
                            A modern marketing site for a residential solar
                            installation company. Features a lead-capture form,
                            service breakdown, and glowing stats section.
                        </p>
                        <div class="mt-5 flex gap-3">
                            <a
                                href="/services/solar"
                                class="flex-1 text-center bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
                            >
                                View Project
                            </a>
                            <a
                                href="#"
                                class="flex-1 text-center border border-slate-200 hover:border-blue-300 hover:text-blue-600 text-slate-700 text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
                            >
                                Live Demo
                            </a>
                        </div>
                    </div>
                </article>

                <!-- ── Project Card 2: Barbershop ── -->
                <article
                    class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col"
                >
                    <div class="overflow-hidden">
                        <img
                            src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=600&h=360&fit=crop&auto=format"
                            alt="Barber styling a client's hair in a modern barbershop"
                            class="w-full h-48 object-cover hover:scale-105 transition-transform duration-500"
                            width="600"
                            height="360"
                        />
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <div class="flex gap-2 mb-3">
                            <span
                                class="text-xs font-medium bg-purple-50 text-purple-600 px-2 py-0.5 rounded-md"
                                >HTML/CSS</span
                            >
                            <span
                                class="text-xs font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded-md"
                                >Booking</span
                            >
                        </div>
                        <h3 class="text-lg font-bold text-slate-900">
                            Classic Cuts Barbershop
                        </h3>
                        <p
                            class="mt-2 text-sm text-slate-600 leading-relaxed flex-1"
                        >
                            A sleek barbershop site with a gallery, service
                            menu, and online booking section. Bold typography
                            and dark color scheme match the brand's premium
                            feel.
                        </p>
                        <div class="mt-5 flex gap-3">
                            <a
                                href="/services/barbershop"
                                class="flex-1 text-center bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
                            >
                                View Project
                            </a>
                            <a
                                href="#"
                                class="flex-1 text-center border border-slate-200 hover:border-blue-300 hover:text-blue-600 text-slate-700 text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
                            >
                                Live Demo
                            </a>
                        </div>
                    </div>
                </article>

                <!-- ── Project Card 3: Photography ── -->
                <article
                    class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col"
                >
                    <div class="overflow-hidden">
                        <img
                            src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=600&h=360&fit=crop&auto=format"
                            alt="Photographer holding a DSLR camera with lens"
                            class="w-full h-48 object-cover hover:scale-105 transition-transform duration-500"
                            width="600"
                            height="360"
                        />
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <div class="flex gap-2 mb-3">
                            <span
                                class="text-xs font-medium bg-rose-50 text-rose-600 px-2 py-0.5 rounded-md"
                                >Astro</span
                            >
                            <span
                                class="text-xs font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded-md"
                                >Portfolio</span
                            >
                        </div>
                        <h3 class="text-lg font-bold text-slate-900">
                            Lens &amp; Light Photography
                        </h3>
                        <p
                            class="mt-2 text-sm text-slate-600 leading-relaxed flex-1"
                        >
                            A stunning portfolio site for a wedding and portrait
                            photographer. Full-screen gallery, session booking
                            form, packages page, and Instagram feed integration.
                        </p>
                        <div class="mt-5 flex gap-3">
                            <a
                                href="/services/photography"
                                class="flex-1 text-center bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
                            >
                                View Project
                            </a>
                            <a
                                href="#"
                                class="flex-1 text-center border border-slate-200 hover:border-blue-300 hover:text-blue-600 text-slate-700 text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
                            >
                                Live Demo
                            </a>
                        </div>
                    </div>
                </article>
            </div>

            <!-- View all link -->
            <div class="text-center mt-12">
                <a
                    href="#"
                    class="inline-flex items-center gap-2 text-blue-600 font-semibold hover:text-blue-700 transition-colors group"
                >
                    View All Projects
                    <svg
                        class="w-4 h-4 transition-transform group-hover:translate-x-1"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- ============================================================
       SECTION 4: CONTACT
       id="contact" — linked from navbar
       ============================================================ -->
    <section id="contact" class="py-20 md:py-28 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
                <!-- Left: text and contact info -->
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <span class="w-8 h-0.5 bg-blue-600"></span>
                        <span
                            class="text-blue-600 font-medium text-sm uppercase tracking-wider"
                            >Contact</span
                        >
                    </div>
                    <h2 class="text-3xl sm:text-4xl font-bold text-slate-900">
                        Let's Build Something
                        <span class="text-blue-600">Together</span>
                    </h2>
                    <p class="mt-4 text-slate-600 leading-relaxed max-w-md">
                        Have a project in mind? Whether you need a brand new
                        website or want to improve an existing one, I'd love to
                        hear from you. Fill out the form and I'll get back to
                        you within 24 hours.
                    </p>

                    <div class="mt-8 space-y-4">
                        <div class="flex items-center gap-4">
                            <div
                                class="w-10 h-10 bg-blue-50 rounded-lg flex items-center justify-center text-blue-600 shrink-0"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <p
                                    class="text-xs text-slate-500 font-medium uppercase tracking-wide"
                                >
                                    Email
                                </p>
                                <a
                                    href="mailto:hello@devportfolio.com"
                                    class="text-slate-700 hover:text-blue-600 transition-colors font-medium"
                                >
                                    hello@devportfolio.com
                                </a>
                            </div>
                        </div>

                        <div class="flex items-center gap-4">
                            <div
                                class="w-10 h-10 bg-blue-50 rounded-lg flex items-center justify-center text-blue-600 shrink-0"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    ></path>
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <p
                                    class="text-xs text-slate-500 font-medium uppercase tracking-wide"
                                >
                                    Location
                                </p>
                                <p class="text-slate-700 font-medium">
                                    Remote — Available Worldwide
                                </p>
                            </div>
                        </div>

                        <div class="flex items-center gap-4">
                            <div
                                class="w-10 h-10 bg-green-50 rounded-lg flex items-center justify-center text-green-600 shrink-0"
                            >
                                <span
                                    class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse"
                                ></span>
                            </div>
                            <div>
                                <p
                                    class="text-xs text-slate-500 font-medium uppercase tracking-wide"
                                >
                                    Status
                                </p>
                                <p class="text-slate-700 font-medium">
                                    Open to new projects
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: contact form -->
                <div
                    class="bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-100"
                >
                    <form name="contact" method="POST" class="space-y-5">
                        <div>
                            <label
                                for="name"
                                class="block text-sm font-semibold text-slate-700 mb-1.5"
                            >
                                Full Name <span class="text-blue-600">*</span>
                            </label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                placeholder="Jane Smith"
                                class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow text-sm"
                            />
                        </div>

                        <div>
                            <label
                                for="email"
                                class="block text-sm font-semibold text-slate-700 mb-1.5"
                            >
                                Email Address <span class="text-blue-600"
                                    >*</span
                                >
                            </label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                placeholder="jane@example.com"
                                class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow text-sm"
                            />
                        </div>

                        <div>
                            <label
                                for="subject"
                                class="block text-sm font-semibold text-slate-700 mb-1.5"
                            >
                                Subject
                            </label>
                            <input
                                type="text"
                                id="subject"
                                name="subject"
                                placeholder="Website for my business"
                                class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow text-sm"
                            />
                        </div>

                        <div>
                            <label
                                for="message"
                                class="block text-sm font-semibold text-slate-700 mb-1.5"
                            >
                                Message <span class="text-blue-600">*</span>
                            </label>
                            <textarea
                                id="message"
                                name="message"
                                required
                                rows="5"
                                placeholder="Tell me about your project — what type of website do you need, your timeline, and any other details..."
                                class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow text-sm resize-none"
                            ></textarea>
                        </div>

                        <button
                            type="submit"
                            class="w-full bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold py-3 px-6 rounded-lg transition-colors shadow-sm shadow-blue-600/20 flex items-center justify-center gap-2 group"
                        >
                            Send Message
                            <svg
                                class="w-4 h-4 transition-transform group-hover:translate-x-1"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                            </svg>
                        </button>

                        <p class="text-xs text-slate-400 text-center">
                            I typically respond within 24 hours. No spam, ever.
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </section>
</Layout>
